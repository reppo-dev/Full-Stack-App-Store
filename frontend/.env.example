# Frontend Environment Configuration Template
# Copy this file to .env.local for local Next.js development.

# URL of the Go backend API
NEXT_PUBLIC_API_URL=http://localhost:8000

# ParsPack S3 Object Storage Credentials (Optional in Phase 0 local development)
PARSPACK_ENDPOINT=https://repo.parspack.com
PARSPACK_ACCESS_KEY=your_access_key
PARSPACK_SECRET_KEY=your_secret_key
PARSPACK_BUCKET_NAME=your_bucket_name
