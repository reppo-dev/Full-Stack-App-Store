# Backend Environment Configuration Template
# Copy this file to .env and adjust values for your local environment.

PORT=8000
APP_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=postgres
DB_SSLMODE=disable

# Cache / Ephemeral Foundation (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Secret for signing authentication tokens (Must be changed in production)
JWT_SECRET=your_jwt_signing_secret_min_32_chars
